{
  "expo": {
    "name": "Lý Sáu VLXD",
    "slug": "sales-manager-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ducloi.salesmanager",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.lysau.salesmanager",
      "adaptiveIcon": {
        "backgroundColor": "#f3f5f8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép ứng dụng dùng Face ID để đăng nhập nhanh."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f3f5f8"
        }
      ]
    ],
    "extra": {
      // "apiUrl": "https://lysauvlxd.shop",
      "apiHost": "192.168.10.65",
      "apiPort": 5000,
      "eas": {
        "projectId": "9a33e4b1-8eec-43e0-a2eb-e1f5e3c8be46"
      }
    },
    "owner": "congtam"
  }
}
