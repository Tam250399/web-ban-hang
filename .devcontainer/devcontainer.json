{
  "name": "SalesManagerProject (Backend + Frontend + DB)",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },

  "forwardPorts": [5000, 5001, 5173, 5433, 9000, 9001],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)" },
    "5000": { "label": "Backend HTTP" },
    "5001": { "label": "Backend HTTPS" },
    "5433": { "label": "Postgres" },
    "9000": { "label": "MinIO API" },
    "9001": { "label": "MinIO Console" }
  },

  "postCreateCommand": "dotnet restore Backend/SalesManagerBE/SalesManagerBE.csproj && npm install --prefix Frontend/sales-manager-fe",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
