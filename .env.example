# Sao chép file này thành ".env" (cùng thư mục với docker-compose.yml) rồi
# điền giá trị thật. KHÔNG commit file .env lên Git (đã có trong .gitignore).

# --- PostgreSQL ---
POSTGRES_PASSWORD=doi_mat_khau_manh_o_day

# --- MinIO ---
MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=doi_mat_khau_manh_o_day

# --- Backend .NET ---
# Chuỗi ngẫu nhiên dài (>= 32 ký tự) dùng để ký JWT. Tạo nhanh bằng lệnh:
#   openssl rand -base64 48
JWT_KEY=

# Domain/IP frontend thật sự sẽ dùng để gọi API, phân tách bằng dấu phẩy
# nếu có nhiều origin (vd: https://banhang.example.com,https://www.example.com)
CORS_ALLOWED_ORIGINS=http://192.168.1.123:8080

# Mật khẩu tài khoản admin đầu tiên. Sau khi backend khởi động và tạo xong
# tài khoản admin, hãy đăng nhập đổi mật khẩu rồi XÓA dòng này khỏi .env.
ADMIN_BOOTSTRAP_PASSWORD=doi_mat_khau_admin_o_day
